{
  "name": "esec-latest-21",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --progress=false",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "format": "prettier --write src package.json tsconfig*.json angular.json vitest.config.ts docs README.md scripts",
    "format:check": "prettier --check src package.json tsconfig*.json angular.json vitest.config.ts docs README.md scripts",
    "check": "npm run check:architecture && npm run typecheck && npm run format:check && npm run build && npm run test:ci",
    "check:architecture": "node scripts/check-architecture.cjs"
  },
  "private": true,
  "packageManager": "npm@11.6.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "ag-grid-angular": "36.3.0",
    "ag-grid-community": "36.3.0",
    "ag-grid-enterprise": "36.3.0",
    "crypto-js": "^4.2.0",
    "highcharts": "^13.1.1",
    "highcharts-angular": "^5.4.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.0",
    "@types/crypto-js": "^4.2.2",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
